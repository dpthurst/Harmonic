ASF = 2^(-1/3)
lASF = line([(n,ASF^n) for n in [0..8]], linestyle="dashed",color='black',legend_label='$\mathrm{Limit}$')

IUcrimson = (125/256, 17/256, 12/256);
IUcream = (225/256, 216/256, 183/256);
IUoldgold = (197/256, 146/256, 23/256);
IUmidnight = (68/256, 105/256, 125/256);
IUmint = (154/256, 220/256, 198/256);
IUlimestone = (174/256, 167/256, 159/256);
IUmajestic = (75/256, 48/256, 106/256);

l111 = line([(0,1),(1,1.4999999999999991),(2,0.7734590803390139),(3,0.8571428571428552),(4,0.5269783264434998),(5,0.5084745762711835),(6,0.3503965064029966),(7,0.30924949857738426),(8,0.2275296753097045)], color=IUmajestic,legend_label='$(1,1,1)$')
l414 = line([(0,1),(1,0.8643567769390834),(2,0.7041241452319315),(3,0.563299316185547),(4,0.44862028442959195),(5,0.35632829130652577),(6,0.28298997412898896),(7,0.22460005703572028),(8,0.17829574869701442)],color=IUcrimson,legend_label='$(4,4,1)$')
l101 = line([(0,1),(1,1.0),(2,0.7500000000000012),(3,0.6249999999999986),(4,0.4791666666666642),(5,0.3895833333333327),(6,0.3034873188405803),(7,0.24398964872510331),(8,0.19176053097351045)],color=IUoldgold, legend_label='$(1,1,0)$')
l1n1 = line([(0,1),(1,2.9999999999999996),(2,0.8643567769390843),(3,1.6153846153846163),(4,0.6782608695652181),(5,0.9041557469112694),(6,0.49517865249457416),(7,0.5257766299070752),(8,0.33953851163404625)], color=IUmint,legend_label='$(1,1,-1)$')


def doplot(obj):
    p = plot_semilogy(obj,base=2,figsize=[6,4],axes_labels=['$n$','$\mathrm{SF}$'],ticks=[[0..8],[4,2,1,1/2,1/4,1/8]],tick_formatter=[["$0$","$1$","$2$","$3$","$4$","$5$","$6$","$7$","$8$"],["$4$","$2$","$1$","$1/2$","$1/4$","$1/8$"]])
    p.set_axes_range(0,8,1/8,4)
    return p
    
logplot = doplot(l414+l111+l101+l1n1+lASF)
logplot1 = doplot(l414)
logplot2 = doplot(l414+l111)
logplot3 = doplot(l414+l111+l101+l1n1)
logplot4 = doplot(l414+l111+l101+l1n1+lASF)

def plotsave():
    logplot.save('logplot.pdf')
    logplot1.save('logplot1.pdf')
    logplot2.save('logplot2.pdf')
    logplot3.save('logplot3.pdf')
    logplot4.save('logplot4.pdf')
